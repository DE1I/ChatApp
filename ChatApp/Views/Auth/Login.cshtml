@{
    ViewData["Title"] = "Login";
    Layout = "_AuthLayout";
}

@section styles {
    <link rel="stylesheet" href="~/css/auth.css" />
} 

<div class="authContainer" id="loginContainer">
    <h1>Login</h1>
    <input type="text" class="authInput" id="usernameInput" placeholder="Username" />
    <input type="password" class="authInput" id="passwordInput" placeholder="Password" />
    <button class="authButton" id="loginButton">Login</button>
    <p>Don't have an account? <a href="/Auth/Register">Click here!</a></p>
</div> 

@section Scripts {
    <script src="~/js/authLogin.js"></script>
}